{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {
    "name": "即梦网页桥接 · 图片 (opencli)",
    "author": "Carlos-Zen",
    "version": "1.0.0",
    "description": "通过本机 opencli-plugin-jimeng-video 的桥接服务，用即梦网页账号（会员积分）生成图片，文生图与参考图生图共用。提示词中的「图N」会自动转成即梦的 @图片N 引用。base_url 填 http://host.docker.internal:17891，API Key 填 opencli jimeng bridge token 输出的令牌，模型名填即梦网页上的图片模型名（如 Seedream 5.5）。"
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "refs": { "source": "reference_images", "encoding": "data_uri" }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v1/jimeng/images",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "aspect_ratio": "{{ aspect_ratio }}",
      "resolution": "{{ resolution }}",
      "refs": [{ "$each": { "in": "inputs.refs", "as": "ref", "item": "{{ ref }}" } }]
    },
    "extract": {
      "task_id": ["$.task_id"],
      "error": ["$.error"]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v1/jimeng/images/{{ task_id }}",
    "extract": {
      "status": ["$.status"],
      "image_url": ["$.image_url"],
      "error": ["$.error"]
    }
  },
  "status_map": {
    "queued": "queued",
    "processing": "running",
    "completed": "succeeded",
    "failed": "failed"
  },
  "capabilities": {
    "text_to_image": true,
    "image_to_image": true,
    "max_reference_images": 10
  }
}
